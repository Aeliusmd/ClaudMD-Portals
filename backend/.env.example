# ClaudMD IdentityServer (password grant) — keep secret server-side only
IDENTITY_URL=https://qaidentity.claudmd.com
IDENTITY_CLIENT_ID=resource
IDENTITY_CLIENT_SECRET=replace-with-qa-client-secret
IDENTITY_SCOPE=openid profile app.api.resource offline_access

# Optional master SQL Server (read-only clinic metadata after login)
MASTER_DB_SERVER=10.103.0.201
MASTER_DB_NAME=ClaudMD_QA_Setup
MASTER_DB_USER=testuser
MASTER_DB_PASSWORD=
MASTER_DB_DRIVER=ODBC Driver 17 for SQL Server

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3217,http://127.0.0.1:3217

# Default activation key used when email links are not yet wired
DEFAULT_ACTIVATION_KEY=20000002
